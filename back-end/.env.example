PORT=8080
APP_ENV=development

# Direct PostgreSQL connection
DATABASE_URL=postgres://auth_user:auth_pass@localhost:5432/auth_db?sslmode=disable

# Optional read replica (defaults to DATABASE_URL when empty)
DATABASE_READ_URL=

# Optional PgBouncer connection (use in production for connection pooling)
# DATABASE_URL=postgres://auth_user:auth_pass@localhost:6432/auth_db?sslmode=disable

REDIS_URL=redis://localhost:6379/0

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
BCRYPT_MAX_CONCURRENT=4

JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
CORS_ORIGIN=http://localhost:3000

# Optional OpenTelemetry OTLP endpoint (host:port, no scheme)
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
